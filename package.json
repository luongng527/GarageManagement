{
  "name": "garagemanagement-cypress-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Cypress UI and API tests for GarageManagement",
  "scripts": {
    "test:open": "cypress open",
    "test:ui": "cypress run --spec 'cypress/e2e/ui/**/*.cy.js'",
    "test:api": "cypress run --spec 'cypress/e2e/api/**/*.cy.js'",
    "test:all": "cypress run",
    "test:chrome": "cypress run --browser chrome",
    "serve:frontend": "http-server frontend -p 5500 -a 127.0.0.1 -c-1",
    "test:live": "cypress run --spec \"cypress/e2e/live/**/*.cy.js\"",
    "test:known-bugs": "cypress run --spec \"cypress/e2e/api/03-known-defects.cy.js\""
  },
  "devDependencies": {
    "cypress": "^15.0.0",
    "http-server": "^14.1.1"
  },
  "allowScripts": {
    "cypress@15.21.1": true
  }
}
